# Expires map
map $sent_http_content_type $expires {
    default                    off;
    text/html                  max; # static html
    text/css                   max;
    application/javascript     max;
    ~image/                    max;
}

server {

        # SSL configuration
        #
        # listen 443 ssl default_server;
        # listen [::]:443 ssl default_server;
        #
        # Note: You should disable gzip for SSL traffic.
        # See: https://bugs.debian.org/773332
        #
        # Read up on ssl_ciphers to ensure a secure configuration.
        # See: https://bugs.debian.org/765782
        #
        # Self signed certs generated by the ssl-cert package
        # Don't use them in a production server!
        #
        # include snippets/snakeoil.conf;

#       root /var/www/webapp/build;

        # Add index.php to the list if you are using PHP
#       index index.html index.htm index.nginx-debian.html;

        server_name onova.co;

        # webapp SSR
        location / {
                proxy_pass http://localhost:3000;
                proxy_http_version 1.1;
                proxy_set_header Upgrade $http_upgrade;
                proxy_set_header Connection 'upgrade';
                proxy_set_header Host $host;
                proxy_cache_bypass $http_upgrade;
                client_max_body_size 60m;
        }

        if ($host = www.onova.co) {
            return 301 https://onova.co$request_uri;
        }

        listen [::]:443 ssl http2 default_server ipv6only=on; # managed by Certbot
        listen 443 ssl http2; # managed by Certbot
        ssl_certificate /etc/letsencrypt/live/onova.co/fullchain.pem; # managed by Certbot
        ssl_certificate_key /etc/letsencrypt/live/onova.co/privkey.pem; # managed by Certbot
        include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot

        ssl_stapling on;
        ssl_stapling_verify on;
        ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

        # config to enable HSTS(HTTP Strict Transport Security) https://developer.mozilla.org/en-US/docs/Security/HTTP_Strict_Transport_Security
        # to avoid ssl stripping https://en.wikipedia.org/wiki/SSL_stripping#SSL_stripping
        # also https://hstspreload.org/
        #add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" preload;

        expires $expires;

        location /api/ {
                proxy_pass http://localhost:4040;
                proxy_http_version 1.1;
                proxy_set_header Upgrade $http_upgrade;
                proxy_set_header Connection 'upgrade';
                proxy_set_header Host $host;
                proxy_cache_bypass $http_upgrade;
                client_max_body_size 60m;
        }

        location /uploader {
                alias /var/www/uploader/dist;
        }
}

server {
    if ($host = www.onova.co) {
        return 301 https://onova.co$request_uri;
    } # managed by Certbot


    if ($host = onova.co) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;

    server_name onova.co www.onova.co;
    return 404; # managed by Certbot
}

