server {
    listen 443 ssl http2; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/onova.co/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/onova.co/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot

    ssl_stapling on;
    ssl_stapling_verify on;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
    server_name chat.onova.co;

    access_log /var/log/nginx/server.chat.access.log;
    error_log /var/log/nginx/server.chat.error.log;

    location / {
        proxy_pass http://localhost:8142;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }
}
